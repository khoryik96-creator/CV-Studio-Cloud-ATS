{
    admin off
    auto_https disable_redirects
    skip_install_trust
}

https://{$CVCLOUD_PILOT_HOST}:8443 {
    tls internal
    reverse_proxy web:8000 {
        header_up Host {$CVCLOUD_PILOT_HOST}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
        header_up -Forwarded
    }
}
